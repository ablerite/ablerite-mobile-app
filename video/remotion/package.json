    "still": "remotion still src/index.ts AbleriteOnboarding out/ablerite-onboarding-cover.png --frame=45"
  },
  "dependencies": {
    "@remotion/cli": "4.0.409",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.409"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "typescript": "5.9.3"
  }
}
