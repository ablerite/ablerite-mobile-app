{
  "name": "ablerite-onboarding-video",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts AbleriteOnboarding out/ablerite-onboarding.mp4 --codec=h264 --crf=18",
